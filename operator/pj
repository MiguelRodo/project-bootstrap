#!/usr/bin/env bash

workspace="${PJ_WORKSPACE:-$HOME/planning}"
cd "$workspace" || exit 1

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
config_dir="$config_home/pj"
default_backend_file="$config_dir/default-backend"

canonical_backend() {
  case "$1" in
    codex)
      printf 'codex\n'
      ;;
    antigravity|agy)
      printf 'antigravity\n'
      ;;
    copilot|github-copilot)
      printf 'copilot\n'
      ;;
    *)
      return 1
      ;;
  esac
}

configured_default_backend() {
  if [ -n "${PJ_DEFAULT_BACKEND:-}" ]; then
    canonical_backend "$PJ_DEFAULT_BACKEND" || return 1
    return
  fi

  if [ -f "$default_backend_file" ]; then
    configured="$(tr -d '[:space:]' < "$default_backend_file")"
    if [ -n "$configured" ]; then
      canonical_backend "$configured" || return 1
      return
    fi
  fi

  printf 'codex\n'
}

set_default_backend() {
  if [ "$#" -ne 1 ]; then
    echo "pj: --set-default requires exactly one backend" >&2
    exit 2
  fi

  backend_value="$(canonical_backend "$1")" || {
    echo "pj: unsupported backend: $1" >&2
    echo "pj: supported backends: codex, antigravity, copilot" >&2
    exit 2
  }

  mkdir -p "$config_dir" || exit 1
  printf '%s\n' "$backend_value" > "$default_backend_file" || exit 1
  printf '%s\n' "$backend_value"
  exit 0
}

if [ "${1:-}" = "--set-default" ]; then
  shift
  set_default_backend "$@"
fi

if [ "${1:-}" = "--show-default" ]; then
  if [ "$#" -ne 1 ]; then
    echo "pj: --show-default does not take arguments" >&2
    exit 2
  fi
  configured_default_backend || {
    echo "pj: configured default backend is invalid" >&2
    exit 2
  }
  exit 0
fi

launcher_name="$(basename "$0")"
case "$launcher_name" in
  pja)
    backend="antigravity"
    ;;
  pjcp)
    backend="copilot"
    ;;
  pjcd)
    backend="codex"
    ;;
  *)
    if [ -n "${PJ_BACKEND:-}" ]; then
      backend="$PJ_BACKEND"
    else
      backend="$(configured_default_backend)" || {
        echo "pj: configured default backend is invalid" >&2
        exit 2
      }
    fi
    ;;
esac

# An explicit backend flag always wins over the launcher-name shorthand or
# configured default.
if [ "${1:-}" = "--backend" ]; then
  if [ "$#" -lt 2 ]; then
    echo "pj: --backend requires a value" >&2
    exit 2
  fi
  backend="$2"
  shift 2
elif [[ "${1:-}" == --backend=* ]]; then
  backend="${1#--backend=}"
  shift
fi

backend="$(canonical_backend "$backend")" || {
  echo "pj: unsupported backend: $backend" >&2
  echo "pj: supported backends: codex, antigravity, copilot" >&2
  exit 2
}

run_codex() {
  defaults=(
    --approve-for-me
    -m "${PJ_CODEX_MODEL:-gpt-5.6-luna}"
    -c 'model_reasoning_effort="xhigh"'
    -c 'sandbox_workspace_write.network_access=true'
  )

  # No arguments: ordinary interactive Codex session.
  if [ "$#" -eq 0 ]; then
    exec codex "${defaults[@]}"
  fi

  # A leading literal `--` means everything after this is prompt text.
  if [ "$1" = "--" ]; then
    shift

    if [ "$#" -eq 0 ]; then
      exec codex "${defaults[@]}"
    fi

    prompt="$*"
    exec codex "${defaults[@]}" "$prompt"
  fi

  # If the first argument begins with a dash, this is a Codex-options
  # invocation. A later literal `--` starts prompt text.
  if [[ "$1" == -* ]]; then
    codex_args=()

    while [ "$#" -gt 0 ]; do
      if [ "$1" = "--" ]; then
        shift

        if [ "$#" -eq 0 ]; then
          exec codex "${defaults[@]}" "${codex_args[@]}"
        fi

        prompt="$*"
        exec codex "${defaults[@]}" "${codex_args[@]}" "$prompt"
      fi

      codex_args+=("$1")
      shift
    done

    exec codex "${defaults[@]}" "${codex_args[@]}"
  fi

  # Otherwise everything supplied is prompt text, including later dashes.
  prompt="$*"
  exec codex "${defaults[@]}" "$prompt"
}

run_antigravity() {
  defaults=(
    --effort high
    --sandbox
    --dangerously-skip-permissions
  )

  # No arguments: ordinary interactive Antigravity session.
  if [ "$#" -eq 0 ]; then
    exec agy "${defaults[@]}"
  fi

  # A leading literal `--` means everything after this is prompt text.
  if [ "$1" = "--" ]; then
    shift

    if [ "$#" -eq 0 ]; then
      exec agy "${defaults[@]}"
    fi

    prompt="$*"
    exec agy "${defaults[@]}" -p "$prompt"
  fi

  # If the first argument begins with a dash, pass Antigravity options until
  # a literal `--`, then combine the remainder into one headless prompt.
  if [[ "$1" == -* ]]; then
    agy_args=()

    while [ "$#" -gt 0 ]; do
      if [ "$1" = "--" ]; then
        shift

        if [ "$#" -eq 0 ]; then
          exec agy "${defaults[@]}" "${agy_args[@]}"
        fi

        prompt="$*"
        exec agy "${defaults[@]}" "${agy_args[@]}" -p "$prompt"
      fi

      agy_args+=("$1")
      shift
    done

    exec agy "${defaults[@]}" "${agy_args[@]}"
  fi

  # Antigravity uses -p for a one-shot prompt. Everything supplied here is
  # prompt text, including later dash-prefixed fragments.
  prompt="$*"
  exec agy "${defaults[@]}" -p "$prompt"
}

run_copilot() {
  defaults=(
    --allow-all
  )

  if [ -n "${PJ_COPILOT_MODEL:-}" ]; then
    defaults+=(--model "$PJ_COPILOT_MODEL")
  fi

  # No arguments: ordinary interactive GitHub Copilot CLI session.
  if [ "$#" -eq 0 ]; then
    exec copilot "${defaults[@]}"
  fi

  # A leading literal `--` means everything after this is prompt text.
  if [ "$1" = "--" ]; then
    shift

    if [ "$#" -eq 0 ]; then
      exec copilot "${defaults[@]}"
    fi

    prompt="$*"
    exec copilot "${defaults[@]}" -p "$prompt"
  fi

  # If the first argument begins with a dash, pass Copilot options until a
  # literal `--`, then combine the remainder into one programmatic prompt.
  if [[ "$1" == -* ]]; then
    copilot_args=()

    while [ "$#" -gt 0 ]; do
      if [ "$1" = "--" ]; then
        shift

        if [ "$#" -eq 0 ]; then
          exec copilot "${defaults[@]}" "${copilot_args[@]}"
        fi

        prompt="$*"
        exec copilot "${defaults[@]}" "${copilot_args[@]}" -p "$prompt"
      fi

      copilot_args+=("$1")
      shift
    done

    exec copilot "${defaults[@]}" "${copilot_args[@]}"
  fi

  # Copilot CLI uses -p for a one-shot prompt. Everything supplied here is
  # prompt text, including later dash-prefixed fragments.
  prompt="$*"
  exec copilot "${defaults[@]}" -p "$prompt"
}

case "$backend" in
  codex)
    run_codex "$@"
    ;;
  antigravity)
    run_antigravity "$@"
    ;;
  copilot)
    run_copilot "$@"
    ;;
esac
